<?xml version="1.0" encoding="UTF-8"?>
<!--
  Liberty WAS Plugin — TRUE Dynamic Routing
  ===========================================
  This file is generated by:  dynamicRouting setup
  Run:  bash scripts/step2-dynamic-routing.sh
  DO NOT hand-edit — it will be overwritten on the next setup run.

  How dynamic routing works:
    - The <Server> entry below points at the Liberty Collective Controller
      on its HTTPS port, not at individual member servers.
    - The plugin calls <controller>:<port>/wr on every RefreshInterval.
    - The controller returns the live routing table of all healthy collective
      members; the plugin routes requests accordingly.
    - Members joining or leaving the collective are reflected automatically
      within one RefreshInterval (60 s by default).

  SSL:
    The plugin authenticates to /wr using the GSKit CMS keystore
    /home/itzuser/IBM/HTTPServer/conf/plugin-key.kdb (created by gskcapicmd).
    The KeyRing attribute below must point at that file.

  Architecture:
    Browser → IHS:8080 ──(mod_was_ap24_http.so)──► controller:9443/wr
                                                         │
                                          live route table from collective
                                                         │
                               ┌─────────────────────────┤
                               ▼                         ▼
                          member3:9083             member4:9084
-->
<Config ASDisableNagle="false" AcceptAllContent="false"
        AppServerPortPreference="HostHeader" ChunkedResponse="false"
        FIPSEnable="false" IISDisableNagle="false" IISPluginPriority="High"
        IgnoreDNSFailures="false" RefreshInterval="60" ResponseChunkSize="64"
        SSLConsolidatedConfig="false" TrustedProxyEnable="false"
        VHostMatchingCompat="false">

    <Log LogLevel="Error" Name="/home/itzuser/IBM/HTTPServer/logs/plugin.log"/>

    <Property Name="ESIEnable"                   Value="false"/>
    <Property Name="ESIMaxCacheSize"              Value="1024"/>
    <Property Name="ESIInvalidationMonitor"       Value="false"/>
    <Property Name="ESIEnableRecursiveInclude"    Value="false"/>
    <Property Name="ESIMaxRecursiveIncludeDepth"  Value="10"/>

    <!--
      Single server entry — the Liberty Collective Controller acting as the
      dynamic routing endpoint.  The plugin does NOT list member servers here;
      the controller provides them at runtime via /wr.
    -->
    <ServerCluster CloneSeparatorChange="false" GetDWLMTable="false"
                   IgnoreAffinityRequests="true" LoadBalance="Round Robin"
                   Name="CollectiveCluster" PostSizeLimit="-1"
                   RemoveSpecialHeaders="true" RetryInterval="60">

        <Server CloneID="controller" ConnectTimeout="5" ExtendedHandshake="false"
                MaxConnections="-1" Name="controller_9443"
                ServerIOTimeout="900" WaitForContinue="false">
            <!--
              HTTPS transport to the controller /wr endpoint.
              KeyRing must point at the GSKit CMS keystore created by gskcapicmd.
              The stashfile (.sth) is the password-stash produced by gskcapicmd -stash.
            -->
            <Transport Hostname="localhost" Port="9443" Protocol="https">
                <Property Name="keyring"   Value="/home/itzuser/IBM/HTTPServer/conf/plugin-key.kdb"/>
                <Property Name="stashfile" Value="/home/itzuser/IBM/HTTPServer/conf/plugin-key.sth"/>
            </Transport>
        </Server>

        <PrimaryServers>
            <Server Name="controller_9443"/>
        </PrimaryServers>

    </ServerCluster>

    <UriGroup Name="CollectiveCluster_URIs">
        <Uri AffinityCookie="JSESSIONID" AffinityURLIdentifier="jsessionid" Name="/*"/>
    </UriGroup>

    <VirtualHostGroup Name="CollectiveHosts">
        <VirtualHost Name="*:8080"/>
    </VirtualHostGroup>

    <Route ServerCluster="CollectiveCluster"
           UriGroup="CollectiveCluster_URIs"
           VirtualHostGroup="CollectiveHosts"/>

</Config>

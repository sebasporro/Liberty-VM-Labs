<?xml version="1.0" encoding="UTF-8"?>
<server description="Collective Controller role override">
    <featureManager>
        <feature>collectiveController-1.0</feature>
        <feature>adminCenter-1.0</feature>
        <feature>appSecurity-5.0</feature>
    </featureManager>

    <!-- User registry — admin credentials for Admin Center and collective join -->
    <!-- realm omitted so Liberty uses the default realm; administrator-role
         then maps the unqualified name "admin" without a realm prefix -->
    <basicRegistry id="basic">
        <user name="admin" password="${admin.password}"/>
    </basicRegistry>

    <!-- Grant the 'admin' user the Administrator role for restConnector-2.0
         and the adminCenter. With a named realm the user must be qualified as
         realm/user — dropping the realm name avoids that mismatch. -->
    <administrator-role>
        <user>admin</user>
    </administrator-role>
</server>

<?xml version="1.0" encoding="UTF-8"?>
<server description="Collective Controller role override">
    <featureManager>
        <feature>collectiveController-1.0</feature>
        <feature>adminCenter-1.0</feature>
        <feature>appSecurity-5.0</feature>
        <!--
          restConnector-2.0 and dynamicRouting-1.0 are declared here alongside
          administrator-role and basicRegistry so that Liberty's role-to-feature
          binding is resolved in the same config pass.
          In Liberty 26, restConnector-2.0 only honours administrator-role when
          the feature and the role are processed together; declaring the feature
          in a separate dropin causes CWWKS9104A (role not granted) even when
          the role element is present in another file.
        -->
        <feature>restConnector-2.0</feature>
        <feature>dynamicRouting-1.0</feature>
    </featureManager>

    <!-- User registry: admin credentials for Admin Center and collective join -->
    <basicRegistry id="basic">
        <user name="admin" password="${admin.password}"/>
    </basicRegistry>

    <!-- Grant admin the Administrator role.
         Covers: adminCenter, restConnector-2.0 (IBMJMXConnectorREST),
         and the dynamicRouting setup CLI. -->
    <administrator-role>
        <user>admin</user>
    </administrator-role>

    <!-- clientAuthentication="false": the WAS plugin connects to
         /ibm/api/dynamicRouting over HTTPS without presenting a client cert.
         Setting clientAuthenticationSupported="true" causes unknown_ca failures. -->
    <ssl id="defaultSSLConfig" clientAuthentication="false"/>

</server>
